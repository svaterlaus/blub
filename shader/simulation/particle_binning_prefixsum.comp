#version 450

// Prefix sum over particle counters stored in FluidDualGridCells (one u32 per grid cell).

#include "../global_bindings.glsl"
#include "particle_binning.glsl"

#define LOCAL_SIZE_SCAN 1024

layout(local_size_x = LOCAL_SIZE_SCAN, local_size_y = 1, local_size_z = 1) in;

shared uint sharedBuffer[LOCAL_SIZE_SCAN];

#define PREFIX_ROUND(OFFSET)                                                     \
    sharedBuffer[localIndex] = result;                                           \
    barrier();                                                                   \
    if (localIndex >= (OFFSET)) {                                                 \
        result += sharedBuffer[localIndex - (OFFSET)];                             \
    }                                                                            \
    barrier();

void main() {
    uint localIndex = gl_LocalInvocationID.x;
    uvec3 r = Rendering.FluidGridResolution;
    uint rx = r.x;
    uint ry = r.y;
    uint rz = r.z;
    uint i = gl_GlobalInvocationID.x;
    uint x = i % rx;
    uint y = (i / rx) % ry;
    uint z = (i / (rx * ry)) % rz;
    uint fi = fluid_grid_cell_linear_index(ivec3(int(x), int(y), int(z)));

    uint result = FluidDualGridCells.Cells[fi];

    PREFIX_ROUND(1u)
    PREFIX_ROUND(2u)
    PREFIX_ROUND(4u)
    PREFIX_ROUND(8u)
    PREFIX_ROUND(16u)
    PREFIX_ROUND(32u)
    PREFIX_ROUND(64u)
    PREFIX_ROUND(128u)
    PREFIX_ROUND(256u)
    PREFIX_ROUND(512u)

#undef PREFIX_ROUND

    if (localIndex == LOCAL_SIZE_SCAN - 1u) {
        sharedBuffer[0] = atomicAdd(ParticleBinningAtomicCounter, result);
    }
    barrier();
    result += sharedBuffer[0];

    if (result != 0u) {
        FluidDualGridCells.Cells[fi] = result;
    }
}
